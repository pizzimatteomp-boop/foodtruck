rules_version = '2';
// Regole di accesso al database VegMan (fase 0, versione definitiva per i ruoli).
//
// Ruoli (in /utenti/{uid}.ruolo, assegnati solo dal titolare):
//   titolare  → tutto
//   cassa     → comande, scontrini, movimenti senza incasso, quadrature di cassa
//   team      → lettura di eventi, checklist, ricette e prodotti
// Un utente con attivo == false non può fare nulla.
//
// Principi (vedi CLAUDE.md):
//   - gli scontrini registrati non si modificano né si cancellano, nemmeno dal titolare;
//   - i movimenti senza incasso (omaggio, pasto staff, organizzatore, prova, scarto) non hanno campi di importo;
//   - ogni registrazione porta chi l'ha fatta e l'ora del server, non quella del dispositivo.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Chi sei ----------
    function autenticato() { return request.auth != null; }
    function profilo() { return get(/databases/$(database)/documents/utenti/$(request.auth.uid)).data; }
    function attivo() {
      return autenticato()
        && exists(/databases/$(database)/documents/utenti/$(request.auth.uid))
        && profilo().attivo == true;
    }
    function ruolo() { return profilo().ruolo; }
    function titolare() { return attivo() && ruolo() == 'titolare'; }
    function cassa()    { return attivo() && ruolo() in ['titolare', 'cassa']; }
    function team()     { return attivo() && ruolo() in ['titolare', 'cassa', 'team']; }

    // ---------- Controlli sui dati ----------
    function nuovo() { return request.resource.data; }
    // Chi crea il documento è chi è collegato, all'ora del server.
    function firmato() {
      return nuovo().creatoDa == request.auth.uid && nuovo().creatoIl == request.time;
    }
    function testo(v) { return v is string && v.size() > 0 && v.size() <= 500; }

    // ---------- Persone e ruoli ----------
    match /utenti/{uid} {
      allow read: if titolare() || (attivo() && request.auth.uid == uid);
      allow create, update: if titolare()
        && nuovo().keys().hasOnly(['ruolo', 'attivo', 'nome', 'email'])
        && nuovo().ruolo in ['titolare', 'cassa', 'team']
        && nuovo().attivo is bool
        // il titolare non può togliersi da solo il ruolo o disattivarsi (resterebbe chiuso fuori)
        && (uid != request.auth.uid || (nuovo().ruolo == 'titolare' && nuovo().attivo == true));
      allow delete: if titolare() && uid != request.auth.uid;
    }

    // ---------- Ingredienti e prodotti (con le ricette) ----------
    // Il team li legge per preparare: non contengono prezzi d'acquisto né costi.
    match /ingredienti/{id} {
      allow read: if team();
      allow create, update: if titolare()
        && nuovo().keys().hasOnly(['nome', 'categoria', 'unita', 'gruppo', 'confezione', 'etichetta'])
        && (!('etichetta' in nuovo()) || (
          nuovo().etichetta.keys().hasOnly(['nomeEn', 'composizione', 'allergeni', 'tracce', 'pesoUnitario', 'controllata'])
          && nuovo().etichetta.allergeni is list && nuovo().etichetta.allergeni.size() <= 14
          && nuovo().etichetta.tracce is list && nuovo().etichetta.tracce.size() <= 14
          && nuovo().etichetta.controllata is bool))
        && testo(nuovo().nome) && nuovo().nome.size() <= 80
        && nuovo().categoria in ['alimentare', 'packaging']
        && testo(nuovo().unita)
        && (nuovo().confezione == null || (nuovo().confezione is number && nuovo().confezione > 0));
      allow delete: if titolare();
    }
    match /prodotti/{id} {
      allow read: if team();
      allow create, update: if titolare()
        && nuovo().keys().hasOnly(['nome', 'nomeEn', 'tipo', 'gruppo', 'prezzo', 'iva', 'resa', 'ricetta', 'quotaVendite', 'inMenu', 'soglia'])
        && testo(nuovo().nome) && nuovo().nome.size() <= 80
        && nuovo().tipo in ['vendibile', 'semilavorato']
        && nuovo().prezzo is number && nuovo().prezzo >= 0
        && nuovo().ricetta is list && nuovo().ricetta.size() <= 100
        && (!('iva' in nuovo()) || nuovo().iva in ['4', '5', '10', '22']);
      allow delete: if titolare();
    }

    // ---------- Prezzi: articoli dei fornitori e acquisti (righe di fattura) ----------
    // Solo il titolare: da qui si calcolano prezzi e food cost.
    match /articoli/{id} {
      allow read, delete: if titolare();
      allow create, update: if titolare()
        && nuovo().keys().hasOnly(['nome', 'unita', 'categoria', 'ingrediente', 'fattore', 'fornitore', 'partitaIva', 'codice'])
        && (nuovo().categoria == null || nuovo().categoria in ['alimentare', 'packaging', 'non_alimentare'])
        && (nuovo().ingrediente == null || nuovo().ingrediente is string)
        && nuovo().fattore is number && nuovo().fattore > 0;
    }
    match /acquisti/{id}    { allow read, write: if titolare(); }

    // Fatture ricevute: si caricano e restano come sono (si possono solo eliminare se caricate per errore).
    match /fatture/{id} {
      allow read, delete: if titolare();
      allow create: if titolare()
        && nuovo().keys().hasOnly(['fornitore', 'partitaIva', 'tipo', 'numero', 'data', 'totale', 'righe', 'file'])
        && testo(nuovo().numero) && nuovo().data is string && nuovo().totale is number;
      allow update: if false;
    }

    // Registro degli import (Planner, fatture): si aggiunge e basta.
    match /importazioni/{id} {
      allow read: if titolare();
      allow create: if titolare() && firmato() && nuovo().origine in ['planner', 'fatture'];
      allow update, delete: if false;
    }

    // ---------- Storico: fotografia mensile di prezzi e food cost, mai modificata ----------
    match /storico/{mese} {
      allow read: if titolare();
      allow create: if titolare() && mese.matches('^[0-9]{4}-[0-9]{2}$') && nuovo().mese == mese
        && nuovo().keys().hasOnly(['mese', 'ingredienti', 'prodotti', 'creatoDa', 'creatoIl']) && firmato();
      allow update, delete: if false;
    }

    // ---------- Impostazioni del titolare ----------
    match /impostazioni/foodcost {
      allow read: if titolare();
      allow write: if titolare() && nuovo().keys().hasOnly(['sogliaRincaro'])
        && nuovo().sogliaRincaro is number && nuovo().sogliaRincaro > 0 && nuovo().sogliaRincaro <= 100;
    }

    // ---------- Menu pubblico (QR code): lo legge chiunque, lo pubblica solo il titolare ----------
    // Contiene solo nomi, prezzi, ingredienti e allergeni dei prodotti in menu.
    match /menu/{id} {
      allow read: if true;
      allow create, update: if titolare() && id == 'pubblico'
        && nuovo().keys().hasOnly(['voci', 'aggiornatoIl', 'aggiornatoDa'])
        && nuovo().voci is list && nuovo().voci.size() <= 200
        && nuovo().aggiornatoDa == request.auth.uid && nuovo().aggiornatoIl == request.time;
      allow delete: if false;
    }

    // ---------- Eventi e checklist ----------
    match /eventi/{id} {
      allow read: if team();
      // Evento: nome, giorni (da/a), luogo, Paese (IT = cassa fiscale italiana), stato.
      allow create, update: if titolare()
        && nuovo().keys().hasOnly(['nome', 'dal', 'al', 'luogo', 'paese', 'stato'])
        && testo(nuovo().nome) && nuovo().nome.size() <= 80
        && nuovo().dal is string && nuovo().dal.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && nuovo().al is string && nuovo().al.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && nuovo().al >= nuovo().dal
        && (!('luogo' in nuovo()) || (nuovo().luogo is string && nuovo().luogo.size() <= 120))
        && nuovo().paese is string && nuovo().paese.matches('^[A-Z]{2}$')
        && nuovo().stato in ['aperto', 'chiuso'];
      allow delete: if titolare();
      match /checklist/{voce} { allow read: if team(); allow write: if titolare(); }
    }

    // ---------- Comande ----------
    match /comande/{id} {
      allow read, create, update: if cassa();
      allow delete: if titolare();
    }

    // ---------- Scontrini (documento commerciale online) ----------
    // Si registrano solo dopo l'esito positivo dell'Agenzia. Annullo e reso sono nuovi scontrini
    // che citano l'originale: l'originale non si tocca.
    match /scontrini/{id} {
      allow read: if cassa();
      // Id = ambiente + idtrx: lo stesso scontrino non si registra due volte (la creazione di un id esistente è rifiutata).
      allow create: if cassa() && firmato()
        && nuovo().keys().hasOnly(['tipo', 'idtrx', 'progressivo', 'evento', 'totale', 'creatoDa', 'creatoIl', 'ambiente',
             'cassa', 'pagamento', 'righe', 'giorno', 'sumup', 'progressivoOriginale', 'idtrxOriginale'])
        && nuovo().tipo in ['V', 'A', 'R']
        && testo(nuovo().idtrx)
        && testo(nuovo().progressivo)
        && testo(nuovo().evento)
        && nuovo().totale is number && nuovo().totale >= 0
        && nuovo().ambiente in ['simulatore', 'agenzia']
        && id == nuovo().ambiente + '-' + nuovo().idtrx
        && testo(nuovo().cassa)
        && nuovo().pagamento in ['contanti', 'elettronico', 'nessuno']
        && nuovo().righe is list && nuovo().righe.size() <= 100
        && nuovo().giorno is string && nuovo().giorno.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (!('sumup' in nuovo()) || testo(nuovo().sumup))
        && (nuovo().tipo == 'V' || testo(nuovo().progressivoOriginale));
      allow update, delete: if false;
    }

    // ---------- Movimenti senza incasso ----------
    // Omaggio, pasto staff, per l'organizzatore, prova/assaggio, scarto: uno per prodotto, nessun campo
    // importo e niente Agenzia (se c'è un pagamento è una vendita e va con lo scontrino o la fattura).
    match /movimenti/{id} {
      allow read: if titolare();
      allow create: if cassa() && firmato()
        && nuovo().keys().hasOnly(['tipo', 'prodotto', 'descrizione', 'quantita', 'motivo', 'persona', 'evento',
                                   'cassa', 'giorno', 'gruppo', 'creatoDa', 'creatoIl'])
        && nuovo().tipo in ['omaggio', 'pasto_staff', 'organizzatore', 'prova', 'scarto']
        && testo(nuovo().prodotto)
        && testo(nuovo().descrizione)
        && nuovo().quantita is int && nuovo().quantita > 0 && nuovo().quantita <= 1000
        && testo(nuovo().motivo)
        && (!('persona' in nuovo()) || testo(nuovo().persona))
        && testo(nuovo().evento)
        && testo(nuovo().cassa)
        && testo(nuovo().gruppo)
        && nuovo().giorno is string && nuovo().giorno.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      allow update, delete: if false;
    }

    // ---------- Chiusura e quadratura di cassa ----------
    // Conta «alla cieca»: chi è in cassa la registra ma non la rilegge; il confronto lo vede il titolare.
    // Una conta registrata non si cambia: una correzione è una nuova conta.
    function importo(v) { return v is number && v >= 0 && v <= 100000; }
    match /quadrature/{id} {
      allow read: if titolare();
      allow create: if cassa() && firmato()
        && nuovo().keys().hasOnly(['evento', 'cassa', 'giorno', 'dal', 'fondo', 'contanti', 'pos', 'attesoContanti', 'attesoPos',
                                   'scontrini', 'annulli', 'nota', 'creatoDa', 'creatoIl'])
        && testo(nuovo().evento)
        && testo(nuovo().cassa)
        && nuovo().giorno is string && nuovo().giorno.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && nuovo().dal is int && nuovo().dal >= 0
        && importo(nuovo().fondo) && importo(nuovo().contanti) && importo(nuovo().pos)
        && nuovo().attesoContanti is number && nuovo().attesoPos is number
        && nuovo().scontrini is int && nuovo().scontrini >= 0
        && nuovo().annulli is int && nuovo().annulli >= 0
        && (!('nota' in nuovo()) || testo(nuovo().nota));
      allow update, delete: if false;
    }

    // ---------- Registro delle operazioni: solo aggiunte ----------
    match /registro/{id} {
      allow read: if titolare();
      allow create: if team() && firmato() && testo(nuovo().azione);
      allow update, delete: if false;
    }

    // Tutto il resto è chiuso.
  }
}
