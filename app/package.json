{
  "name": "vegman-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Super app VegMan: eventi, food cost, magazzino, comande e cassa fiscale",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
