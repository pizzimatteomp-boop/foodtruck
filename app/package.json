{
  "name": "vegman-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Super app VegMan: eventi, food cost, magazzino, comande e cassa fiscale",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc",
    "check": "tsc && vitest run --coverage && npm run test:regole && npm run test:browser",
    "test:regole": "firebase emulators:exec --only firestore --project demo-vegman \"vitest run --config vitest.regole.config.ts\"",
    "test:browser": "firebase emulators:exec --only auth,firestore --project demo-vegman \"playwright test\""
  },
  "dependencies": {
    "bignumber.js": "11.1.5",
    "firebase": "13.1.0",
    "preact": "11.0.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "4.1.12",
    "firebase-tools": "15.34.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6"
  }
}
