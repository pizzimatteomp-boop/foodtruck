    "check": "tsc && vitest run --coverage"
  },
  "dependencies": {
    "bignumber.js": "11.1.5",
    "firebase": "13.1.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.12",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6"
  }
}
